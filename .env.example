# =====================================
# Application
# =====================================
APP_NAME=TiffinPin Backend
APP_ENV=development
APP_PORT=8000

# =====================================
# PostgreSQL
# =====================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tiffinpin
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

DATABASE_URL=postgresql://postgres:postgres@postgres:5432/tiffinpin

# =====================================
# Redis
# =====================================
REDIS_HOST=redis
REDIS_PORT=6379

REDIS_URL=redis://redis:6379

# =====================================
# Security
# =====================================
JWT_SECRET=replace_with_a_secure_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30